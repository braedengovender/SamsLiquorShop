<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="SamsLiquorShop.SiteMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <script>
        (function () {
            var theme = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> | Sam's Liquor Shop</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>
    <webopt:bundlereference runat="server" path="~/Content/css" />
    <%-- Site.css is linked separately with its last-saved time as a version, so browsers fetch the new file whenever it changes --%>
    <asp:PlaceHolder runat="server">
        <link rel="stylesheet" href="<%: ResolveUrl("~/Content/Site.css") %>?v=<%: System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Content/Site.css")).Ticks %>" />
    </asp:PlaceHolder>
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <style>
        .nl-continue-btn {
            border: none;
            outline: none;
            cursor: pointer;
            padding: 14px 36px;
            border-radius: 999px;
            background: var(--accent);
            color: #fff;
            font-family: inherit;
            font-size: 0.95rem;
            font-weight: 600;
            transition: background 0.2s ease;
        }

        .nl-continue-btn:hover {
            background: #006edb;
        }

        [data-theme="dark"] .nl-continue-btn:hover {
            background: #6bb2ff;
        }

        /* --- Search suggestions --- */
        #searchSuggestions .search-suggestion-item {
            display: flex;
            align-items: center;
            gap: 20px;
            padding: 12px 16px;
        }

        #searchSuggestions .search-suggestion-item:hover,
        #searchSuggestions .search-suggestion-item:focus {
            color: var(--text-primary);
            text-decoration: none;
        }

        #searchSuggestions .search-suggestion-img {
            width: 48px;
            height: 48px;
            flex-shrink: 0;
            object-fit: cover;
            border-radius: 8px;
        }

        #searchSuggestions .search-suggestion-name {
            flex: 1;
            min-width: 0;
        }

        #searchSuggestions .search-suggestion-prices {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 4px;
            margin-left: auto;
            padding-left: 24px;
            flex-shrink: 0;
        }

        #searchSuggestions .search-suggestion-price {
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--accent-amber-dark);
            white-space: nowrap;
        }

        #searchSuggestions .search-suggestion-price.is-sale {
            background: var(--accent-amber);
            color: #fff;
            padding: 3px 12px;
            border-radius: 999px;
        }

        #searchSuggestions .search-suggestion-old {
            font-size: 0.78rem;
            color: var(--text-secondary);
            text-decoration: line-through;
            white-space: nowrap;
        }

        [data-theme="dark"] #searchSuggestions .search-suggestion-price {
            color: var(--accent-amber);
        }

        [data-theme="dark"] #searchSuggestions .search-suggestion-price.is-sale {
            color: #fff;
        }

        /* --- Search clear button: centre the X in the grey circle --- */
        #searchBar .search-bar-clear {
            align-items: center;
            justify-content: center;
            padding: 0;
            line-height: 0;
        }

        #searchBar .search-bar-clear svg {
            display: block;
        }

        /* --- Light / dark versions of the responsible drinking image --- */
        img.theme-dark-only {
            display: none;
        }

        [data-theme="dark"] img.theme-dark-only {
            display: block;
        }

        [data-theme="dark"] img.theme-light-only {
            display: none;
        }
    </style>
</head>
<body>
    <div id="ageGate" class="age-gate" style="display:none;">
      <div class="glass age-card">
          <img src="/Images/logo-cropped.png" alt="Sam's Liquor Shop" class="age-card-logo" />
        <p class="age-eyebrow">Sam's Liquor Shop supports the responsible consumption of alcohol.</p>
        <p class="age-question">If you are of legal drinking age, please confirm your date of birth to enter.</p>

        <div class="dob-row">
          <select id="dobDay" class="dob-select"><option value="">Day</option></select>
          <select id="dobMonth" class="dob-select"><option value="">Month</option></select>
          <select id="dobYear" class="dob-select"><option value="">Year</option></select>
        </div>

        <p id="ageError" class="age-error" style="display:none;"></p>

        <div class="age-buttons">
          <button type="button" class="btn-primary" onclick="verifyAge()">Enter Site</button>
          <button type="button" class="btn-ghost age-exit" onclick="exitSite()">No, Get Me Out</button>
        </div>

        <img src="/Images/responsible-drinking.jpg" alt="Drink responsibly" class="age-image theme-light-only" />
        <img src="/Images/responsible-drinking-dark.svg" alt="Drink responsibly" class="age-image theme-dark-only" />
      </div>
    </div>
    <script>
        if (sessionStorage.getItem('ageVerified') !== 'true') {
            document.getElementById('ageGate').style.display = 'flex';
        }
    </script>

    <div id="newsletterModal" class="newsletter-overlay">
      <div class="glass newsletter-card">
        <button type="button" class="newsletter-close" onclick="closeNewsletter()" aria-label="Close">&times;</button>

        <div class="newsletter-visual">
          <svg class="newsletter-decor" viewBox="0 0 300 400" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <g fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.85">
              <path d="M 130 30 L 130 60 Q 130 68 120 76 Q 100 92 100 118 L 100 340 Q 100 358 118 358 L 182 358 Q 200 358 200 340 L 200 118 Q 200 92 180 76 Q 170 68 170 60 L 170 30 Z" />
              <rect x="126" y="14" width="48" height="18" rx="4" />
              <line x1="100" y1="180" x2="200" y2="180" stroke-width="1.2" opacity="0.5" />
            </g>
            <g clip-path="url(#nlBottleClip)">
              <rect x="100" y="358" width="100" height="140" fill="var(--accent-amber)" opacity="0.4" />
            </g>
            <defs>
              <clipPath id="nlBottleClip">
                <path d="M 100 180 L 100 340 Q 100 358 118 358 L 182 358 Q 200 358 200 340 L 200 180 Z" />
              </clipPath>
            </defs>
          </svg>
          <p class="newsletter-visual-tag">Sam's Liquor Shop</p>
          <h2 class="newsletter-visual-heading">Welcome to Durban's Finest Drinks Selection</h2>
          <p class="newsletter-visual-sub">From spirits to global wines — your journey starts here.</p>
        </div>

        <div class="newsletter-form-side">
          <p class="newsletter-form-eyebrow">Join Our Community</p>
          <p class="newsletter-form-lead">Sign up and be the first to hear about new arrivals, tastings, and exclusive offers.</p>

          <div id="newsletterForm" class="newsletter-form">
            <div class="form-row">
              <div class="form-group">
                <input type="text" id="nlFirstName" placeholder="First name" />
                <span class="field-error" id="nlFirstNameError"></span>
              </div>
              <div class="form-group">
                <input type="text" id="nlLastName" placeholder="Last name" />
                <span class="field-error" id="nlLastNameError"></span>
              </div>
            </div>
            <div class="form-group">
              <input type="email" id="nlEmail" placeholder="Email address" />
              <span class="field-error" id="nlEmailError"></span>
            </div>
            <button type="button" class="btn-primary newsletter-submit" onclick="submitNewsletter(event)">Sign Up</button>
            <p class="newsletter-terms">
              By signing up, you agree to receive marketing emails. View our
              <a href="/Legal.aspx#privacy">privacy policy</a> and <a href="/Legal.aspx#website-terms">terms of service</a>.
            </p>
          </div>
          <div id="newsletterSuccess" class="newsletter-success" style="display:none; text-align:center; padding:24px 0;">
              <div style="width:56px; height:56px; margin:0 auto 20px;">
                <svg viewBox="0 0 52 52" width="56" height="56" aria-hidden="true" style="display:block;">
                  <circle cx="26" cy="26" r="24" fill="none" stroke="#c9a24b" stroke-width="2" />
                  <path d="M16 27 L23 34 L37 19" fill="none" stroke="#c9a24b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
              <h3 style="font-size:1.5rem; font-weight:700; margin:0 0 10px;">You're in!</h3>
              <p style="color:var(--text-secondary); font-size:0.95rem; line-height:1.5; margin:0 0 28px;">Thanks for signing up - keep an eye on your inbox for new arrivals, tastings, and exclusive offers.</p>
              <button type="button" class="nl-continue-btn" onclick="closeNewsletter()">Continue Browsing</button>
          </div>
        </div>

      </div>
    </div>

    <button type="button" id="backToTop" class="back-to-top" aria-label="Back to top">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
    </button>

    <div class="chatbot-widget">
      <div id="chatbotPanel" class="glass chatbot-panel" style="display:none;">
        <div class="chatbot-header">
          <img src="/Images/cartIcon.png" alt="Sam's Liquor Shop" class="chatbot-header-logo" />
          <span>Sam's Assistant</span>
        </div>
        <div id="chatbotMessages" class="chatbot-messages">
          <div class="chatbot-msg bot">Cheers for stopping by! 🥂 Ask me anything, or tap a question below.</div>
          <div class="chatbot-quick-replies">
            <button type="button" class="quick-reply" onclick="askQuick('hours')">What are your trading hours?</button>
            <button type="button" class="quick-reply" onclick="askQuick('location')">Where are you located?</button>
            <button type="button" class="quick-reply" onclick="askQuick('delivery')">Do you deliver?</button>
            <button type="button" class="quick-reply" onclick="askQuick('loyalty')">How does the loyalty card work?</button>
          </div>
        </div>
        <div class="chatbot-input-row">
          <input type="text" id="chatbotInput" placeholder="Type a message..." onkeypress="if(event.key==='Enter'){sendChatMessage(event);}" />
          <button type="button" onclick="sendChatMessage(event)">&rarr;</button>
        </div>
      </div>
      <button type="button" class="chatbot-toggle glass" onclick="toggleChatbot()" aria-label="Chat with us">
        <img src="/Images/chatbot-icon.png" alt="Chat" class="chatbot-toggle-logo" />
      </button>
    </div>

    <div id="cookieBanner" class="cookie-banner" style="display:none;">
      <div class="glass cookie-card">
        <p>We value your privacy. We use cookies to enhance your browsing experience, serve personalised ads or content, and analyse our traffic. By clicking "Accept All", you consent to our use of cookies.</p>
        <div class="cookie-actions">
          <button type="button" class="btn-ghost cookie-decline" onclick="dismissCookieBanner()">Decline</button>
          <button type="button" class="btn-primary" onclick="acceptCookies()">Accept All</button>
        </div>
      </div>
    </div>

    <div id="pageLoader" class="loading-overlay" style="display: none;">
        <div class="loader-aurora" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="loader-stage">
            <div class="loader-logo-wrap">
                <img src="/Images/logo-cropped.png" alt="" class="loader-logo" aria-hidden="true" />
            </div>
            <div class="loader-tagline" id="loaderTagline" aria-hidden="true"><span class="is-on">Spirits</span></div>
            <div class="loader-bar" aria-hidden="true"><span></span></div>
        </div>
    </div>

    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <%--To learn more about bundling scripts in ScriptManager see https://go.microsoft.com/fwlink/?LinkID=301884 --%>
                <%--Framework Scripts--%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
                <%--Site Scripts--%>
            </Scripts>
        </asp:ScriptManager>

        <header class="site-header shell">
          <nav class="glass nav-bar">
            <a href="~/Default.aspx" runat="server" class="brand-logo-link">
              <img src="/Images/logo-spaced.png" alt="Sam's Liquor Shop" class="brand-logo" />
            </a>
            <ul class="nav-links">
              <li class="has-dropdown">
                <a href="~/Shop.aspx" runat="server">Shop</a>
                <div class="dropdown-menu">
                    <asp:Repeater ID="rptNavCategories" runat="server">
                        <ItemTemplate>
                            <a href='<%# "Shop.aspx?cat=" + Eval("Category_ID") %>'><%# Eval("Category_Name") %></a>
                        </ItemTemplate>
                    </asp:Repeater>
                    <a href="Shop.aspx" class="dropdown-view-all">View All Products</a>
                </div>
              </li>
              <li><a href="~/Specials.aspx" runat="server">Specials</a></li>
              <li><a href="~/Shipping.aspx" runat="server">Shipping</a></li>
              <li><a href="~/Rewards.aspx" runat="server">Rewards</a></li>
              <li class="has-dropdown">
                <a href="~/About.aspx" runat="server">About Us</a>
                <div class="dropdown-menu">
                  <a href="About.aspx">Our Story</a>
                  <a href="Blog.aspx">Blog & Newsletter</a>
                  <a href="Sustainability.aspx">Sustainability</a>
                  <a href="Gallery.aspx">Gallery</a>
                </div>
              </li>
              <li class="has-dropdown">
                  <a href="~/AdviceAndHelp.aspx" runat="server">Advice & Help</a>
                  <div class="dropdown-menu">
                  <a href="ResponsibleDrinking.aspx">Responsible Drinking Support</a>
                  <a href="FAQ.aspx">FAQ</a>
                  <a href="Shipping.aspx">Shipping & Delivery Info</a>
                  <a href="ReturnPolicy.aspx">Returns & Refunds</a>
                  <a href="/Legal.aspx">Legal & Policies</a>
                
                </div>
              </li>
              <li><a href="~/Contact.aspx" runat="server">Contact</a></li>
            </ul>
              <div class="nav-auth">
                  <button type="button" class="icon-btn" onclick="toggleSearch()" aria-label="Search">
                      <img src="/Images/icons/search.png" alt="" class="nav-icon" width="20" height="20" />
                  </button>
                  <a href="Shop.aspx?wishlist=1" class="icon-btn cart-icon-wrap" aria-label="Wishlist">
                      <asp:UpdatePanel ID="upnlWishBadge" runat="server" UpdateMode="Always" RenderMode="Inline">
                          <ContentTemplate>
                              <svg class="wish-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg>
                              <asp:Literal runat="server" ID="litWishCount" />
                          </ContentTemplate>
                      </asp:UpdatePanel>
                  </a>
                  <a href="Cart.aspx" class="icon-btn cart-icon-wrap" aria-label="Cart">
                      <asp:UpdatePanel ID="upnlCartBadge" runat="server" UpdateMode="Always" RenderMode="Inline">
                          <ContentTemplate>
                              <asp:Image ID="imgCart" runat="server" CssClass="nav-icon" Width="20" Height="20"
                                  ImageUrl="~/Images/icons/emptycart.png" AlternateText="" />
                              <asp:Literal runat="server" ID="litCartCount" />
                          </ContentTemplate>
                      </asp:UpdatePanel>
                  </a>

                  <asp:PlaceHolder runat="server" ID="phLoggedOut">
                      <a runat="server" href="~/Login.aspx" class="btn-ghost">Log in</a>
                      <%--<a runat="server" href="~/Account/Register" class="btn-primary">Register</a>--%>
                      <a runat="server" href="~/Register.aspx" class="btn-primary">Register</a>
                  </asp:PlaceHolder>

                  <asp:PlaceHolder runat="server" ID="phLoggedIn" Visible="false">
                      <a runat="server" id="lnkProfile" href="~/Customer/Dashboard.aspx" class="icon-btn" aria-label="My Dashboard">&#128100;</a>
                      <asp:LinkButton runat="server" ID="btnLogout" CssClass="btn-ghost" OnClick="btnLogout_Click">Log out</asp:LinkButton>
                  </asp:PlaceHolder>

                  <button type="button" id="themeToggle" class="theme-toggle" onclick="toggleTheme()" aria-label="Toggle dark mode">
                      <img id="themeIcon" src="/Images/icons/moon.png" alt="" class="nav-icon" width="20" height="20" />
                  </button>
              </div>
          </nav>
            <div id="searchBar" class="search-bar" style="display:none;">
                <div class="search-bar-inner glass">
                    <img src="/Images/icons/search.png" alt="" class="nav-icon search-bar-icon-img" width="18" height="18" />
                    <input type="text" id="headerSearchInput" placeholder="Search for products..." autocomplete="off" />
                    <button type="button" class="search-bar-clear" id="searchClearBtn" onclick="clearHeaderSearch()" aria-label="Clear search" style="display:none;"><svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 2 L10 10 M10 2 L2 10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none" /></svg></button>
                </div>
                <div id="searchSuggestions" class="search-suggestions glass" style="display:none;"></div>
            </div>
        </header>

        <div class="shell body-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </div>

        <section class="shell site-footer-main">
          <div class="footer-top">
              <div class="footer-brand">
                <img src="/Images/logo-cropped.png" alt="Sam's Liquor Shop" class="footer-logo" />
                <p class="footer-tagline">Durban's trusted liquor store — spirits, wine and more, delivered right.</p>
                <address>
                  21 Coronation Road<br />
                  Tongaat, Durban, 4399<br />
                  KwaZulu-Natal
                </address>
                <p><a href="tel:+27824055932">082 405 5932</a></p>
                <p><a href="mailto:info@samsliquorshop.co.za">info@samsliquorshop.co.za</a></p>

                <div class="footer-social">
                  <a href="#" aria-label="Facebook"><img src="/Images/social/facebook.png" alt="Facebook" /></a>
                  <a href="#" aria-label="Instagram"><img src="/Images/social/instagram.png" alt="Instagram" /></a>
                  <a href="#" aria-label="X"><img src="/Images/social/x.png" alt="Twitter" /></a>
                  <a href="#" aria-label="YouTube"><img src="/Images/social/youtube.png" alt="YouTube" /></a>
                  <a href="#" aria-label="TikTok"><img src="/Images/social/tiktok.png" alt="TikTok" /></a>
                </div>

                <div class="footer-map">
                  <iframe
                    src="https://www.google.com/maps?q=21+Coronation+Road,+Tongaat,+4399&output=embed"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade">
                  </iframe>
                </div>
              </div>

              <div class="footer-col">
                <h3>Shop</h3>
                <ul>
                  <li><a href="Shop.aspx">All Products</a></li>
                  <li><a href="Specials.aspx">Specials</a></li>
                  <li><a href="Shop.aspx?cat=gifts">Gift Ideas & Accessories</a></li>
                  <li><a href="About.aspx">About Us</a></li>
                  <li><a href="Contact.aspx">Contact</a></li>
                </ul>
              </div>

              <div class="footer-col">
                <h3>Your Account</h3>
                <ul>
                  <li><a href="Account/Profile.aspx">My Profile</a></li>
                  <li><a href="Account/Orders.aspx">My Orders</a></li>
                  <li><a href="WishList.aspx">Wish List</a></li>
                  <li><a href="Account/Settings.aspx">Settings</a></li>
                  <li><a href="Loyalty.aspx">Loyalty & Rewards</a></li>
                  <li><a href="Loyalty.aspx#card">Get the Loyalty Card</a></li>
                </ul>
              </div>

              <div class="footer-col">
                <h3>Support</h3>
                <ul>
                  <li><a href="FAQ.aspx">FAQ</a></li>
                  <li><a href="Shipping.aspx">Delivery Policy</a></li>
                  <li><a href="ReturnPolicy.aspx">Return Policy</a></li>
                  <li><a href="/Legal.aspx#privacy">Privacy Policy</a></li>
                  <li><a href="/Legal.aspx#cookies">Cookies Policy</a></li>
                  <li><a href="/Legal.aspx#terms">Terms & Conditions</a></li>
                  <li><a href="/Legal.aspx#website-terms">Website Terms of Use</a></li>
                </ul>
              </div>

              <div class="footer-col">
                <h3>Trading Hours</h3>
                <ul class="hours-list">
                  <li><span>Mon – Thu</span><span>09:00 – 18:00</span></li>
                  <li><span>Fri – Sat</span><span>09:00 – 20:00</span></li>
                  <li><span>Sunday</span><span>10:00 – 15:00</span></li>
                  <li><span>Public Holidays</span><span>10:00 – 15:00</span></li>
                </ul>
                <p class="hours-note">Trading hours may vary in accordance with liquor licensing regulations.</p>
              </div>
            </div>

          <div class="footer-newsletter-band">
            <div class="newsletter-band-text">
              <h3>Be the first to know!</h3>
              <p>Sign up for our newsletter for the latest deals and what's new.</p>
            </div>
            <div class="footer-newsletter-form" id="footerNewsletterForm">
              <div class="footer-field">
                <input type="text" placeholder="First name" id="footerFirstName" class="footer-input" />
                <span class="field-error" id="footerFirstNameError"></span>
              </div>
              <div class="footer-field">
                <input type="text" placeholder="Last name" id="footerLastName" class="footer-input" />
                <span class="field-error" id="footerLastNameError"></span>
              </div>
              <div class="footer-field footer-field-email">
                <input type="email" placeholder="Email address" id="footerEmail" class="footer-input" />
                <span class="field-error" id="footerEmailError"></span>
               </div>
              <button type="button" class="btn-primary" onclick="submitFooterNewsletter(event)">Sign Up</button>
            </div>
            <p id="footerNewsletterSuccess" class="footer-newsletter-success" style="display:none;">&#10003; You're subscribed — thanks for joining!</p>
            <p class="footer-newsletter-privacy">How do we use your information? Read our <a href="/Legal.aspx#privacy">privacy policy</a>.</p>
          </div>
        </section>

        <footer class="shell footer-stack">
          <div class="glass footer-credit">
            <p>&copy; 2026 Sam's Liquor Shop - All Rights Reserved. Designed by The Byte Club.</p>
          </div>
          <div class="glass footer-responsible">
            <img src="/Images/responsible-drinking.jpg" alt="Please drink responsibly" class="theme-light-only" />
            <img src="/Images/responsible-drinking-dark.svg" alt="Please drink responsibly" class="theme-dark-only" />
          </div>
          <div class="glass footer-info">
            <div class="footer-security">
              <span class="lock-icon">&#128274;</span>
              <span>100% Secure Checkout</span>
            </div>
            <div class="footer-payments">
              <span class="payments-label">Approved payment methods</span>
              <div class="payment-icons">
                <img src="/Images/payments/visa.svg" alt="Visa" />
                <img src="/Images/payments/mastercard.svg" alt="Mastercard" />
                <img src="/Images/payments/debit.svg" alt="Debit Card" />
              </div>
            </div>
            <div class="footer-lang">
              <span>English</span>
              <button type="button" id="langToggle" class="lang-toggle" onclick="toggleLang()">
                <span class="lang-knob"></span>
              </button>
              <span>isiZulu</span>
            </div>
          </div>
</footer>
    </form>
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>
    <script>

        // Demo only: opens Google's real sign-in page in a popup. Nothing returns to the site afterwards.
        function googleDemoSignIn() {
            var w = 500, h = 650;
            var left = Math.max(0, (window.screen.width - w) / 2);
            var top = Math.max(0, (window.screen.height - h) / 2);
            var popup = window.open('https://accounts.google.com/signin', 'googleSignIn',
                'width=' + w + ',height=' + h + ',left=' + left + ',top=' + top);
            if (!popup) window.location.href = 'https://accounts.google.com/signin';
        }

        function toggleTheme() {
            var current = document.documentElement.getAttribute('data-theme');
            var next = current === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            setThemeIcon(next);
            localStorage.setItem('theme', next);
        }

        function toggleSearch() {
            var bar = document.getElementById('searchBar');
            var isHidden = bar.style.display === 'none';
            bar.style.display = isHidden ? 'block' : 'none';
            if (isHidden) {
                document.getElementById('headerSearchInput').focus();
            } else {
                document.getElementById('searchSuggestions').style.display = 'none';
            }
        }

        function setThemeIcon(theme) {
            document.getElementById('themeIcon').src =
                theme === 'dark' ? '/Images/icons/sun.png' : '/Images/icons/moon.png';
        }

        function clearHeaderSearch() {
            var input = document.getElementById('headerSearchInput');
            input.value = '';
            input.focus();
            document.getElementById('searchClearBtn').style.display = 'none';
            document.getElementById('searchSuggestions').style.display = 'none';
        }

        (function () {
            var input = document.getElementById('headerSearchInput');
            var box = document.getElementById('searchSuggestions');
            var clearBtn = document.getElementById('searchClearBtn');
            var debounceTimer = null;
            var activeIndex = -1;

            function escapeHtml(str) {
                var div = document.createElement('div');
                div.textContent = str;
                return div.innerHTML;
            }

            function goToSearch(term) {
                showPageLoader();
                window.location.href = 'Shop.aspx?search=' + encodeURIComponent(term);
            }

            function render(items) {
                if (!items || items.length === 0) {
                    box.innerHTML = '<div class="search-suggestion-empty">No matching products</div>';
                    box.style.display = 'block';
                    activeIndex = -1;
                    return;
                }

                box.innerHTML = items.map(function (item) {
                    return '<a href="Shop.aspx?search=' + encodeURIComponent(item.name) + '" class="search-suggestion-item" data-name="' + escapeHtml(item.name) + '">' +
                        '<img src="' + item.image + '" alt="" class="search-suggestion-img" width="48" height="48" />' +
                        '<span class="search-suggestion-name">' + escapeHtml(item.name) + '</span>' +
                        '<span class="search-suggestion-prices">' +
                        (item.oldPrice ? '<span class="search-suggestion-old">' + escapeHtml(item.oldPrice) + '</span>' : '') +
                        '<span class="search-suggestion-price' + (item.oldPrice ? ' is-sale' : '') + '">' + escapeHtml(item.price) + '</span>' +
                        '</span>' +
                        '</a>';
                }).join('');
                box.style.display = 'block';
                activeIndex = -1;

                box.querySelectorAll('.search-suggestion-item').forEach(function (link) {
                    link.addEventListener('click', function () { showPageLoader(); });
                });
            }

            input.addEventListener('input', function () {
                var term = input.value.trim();
                clearBtn.style.display = term.length > 0 ? 'flex' : 'none';
                clearTimeout(debounceTimer);

                if (term.length < 2) {
                    box.style.display = 'none';
                    return;
                }

                debounceTimer = setTimeout(function () {
                    fetch('SearchSuggestions.ashx?term=' + encodeURIComponent(term))
                        .then(function (res) { return res.json(); })
                        .then(render)
                        .catch(function () { box.style.display = 'none'; });
                }, 250);
            });

            input.addEventListener('keydown', function (e) {
                var items = box.querySelectorAll('.search-suggestion-item');

                if (e.key === 'ArrowDown' && items.length > 0) {
                    e.preventDefault();
                    activeIndex = Math.min(activeIndex + 1, items.length - 1);
                    items.forEach(function (it, i) { it.classList.toggle('is-active', i === activeIndex); });
                } else if (e.key === 'ArrowUp' && items.length > 0) {
                    e.preventDefault();
                    activeIndex = Math.max(activeIndex - 1, 0);
                    items.forEach(function (it, i) { it.classList.toggle('is-active', i === activeIndex); });
                } else if (e.key === 'Enter') {
                    e.preventDefault();
                    if (activeIndex >= 0 && items[activeIndex]) {
                        goToSearch(items[activeIndex].getAttribute('data-name'));
                    } else if (input.value.trim().length > 0) {
                        goToSearch(input.value.trim());
                    }
                } else if (e.key === 'Escape') {
                    box.style.display = 'none';
                }
            });

            document.addEventListener('click', function (e) {
                if (!e.target.closest('.search-bar')) {
                    box.style.display = 'none';
                }
            });
        })();

        // Set the correct icon on load based on saved preference
        window.addEventListener('DOMContentLoaded', function () {
            var current = document.documentElement.getAttribute('data-theme');
            setThemeIcon(current);
        });

        (function populateDobDropdowns() {
            var daySel = document.getElementById('dobDay');
            var monthSel = document.getElementById('dobMonth');
            var yearSel = document.getElementById('dobYear');

            for (var d = 1; d <= 31; d++) {
                daySel.innerHTML += '<option value="' + d + '">' + d + '</option>';
            }

            var months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
            for (var m = 0; m < months.length; m++) {
                monthSel.innerHTML += '<option value="' + (m + 1) + '">' + months[m] + '</option>';
            }

            var currentYear = new Date().getFullYear();
            for (var y = currentYear; y >= currentYear - 100; y--) {
                yearSel.innerHTML += '<option value="' + y + '">' + y + '</option>';
            }
        })();

        function verifyAge() {
            var day = document.getElementById('dobDay').value;
            var month = document.getElementById('dobMonth').value;
            var year = document.getElementById('dobYear').value;
            var errorEl = document.getElementById('ageError');

            if (!day || !month || !year) {
                errorEl.textContent = "Please select your full date of birth.";
                errorEl.style.display = "block";
                return;
            }

            var dob = new Date(Number(year), Number(month) - 1, Number(day));

            // Reject impossible dates such as 31 February (JavaScript would roll them into March)
            if (isNaN(dob.getTime()) ||
                dob.getFullYear() !== Number(year) ||
                dob.getMonth() !== Number(month) - 1 ||
                dob.getDate() !== Number(day)) {
                errorEl.textContent = "That date doesn't exist. Please check your date of birth.";
                errorEl.style.display = "block";
                return;
            }

            var today = new Date();

            if (dob > today) {
                errorEl.textContent = "Your date of birth can't be in the future.";
                errorEl.style.display = "block";
                return;
            }
            var age = today.getFullYear() - dob.getFullYear();
            var m = today.getMonth() - dob.getMonth();
            if (m < 0 || (m === 0 && today.getDate() < dob.getDate())) {
                age--;
            }

            if (age < 18) {
                errorEl.textContent = "You must be 18 or older to enter this site.";
                errorEl.style.display = "block";
                return;
            }

            errorEl.style.display = "none";

            // Private browsing can make sessionStorage throw; the visitor should still get in
            try { sessionStorage.setItem('ageVerified', 'true'); } catch (ex) { }

            var gate = document.getElementById('ageGate');
            if (gate) gate.style.display = "none";

            // Loading animation first, then the newsletter pop-up
            showAgeLoader(showNewsletter);
        }

        // ===== Loading screen shown right after the age check =====
        var AGE_LOADER_MS = 2000;   // how long it stays up, in milliseconds
        var ageLoaderRunning = false;

        function showAgeLoader(done) {
            if (ageLoaderRunning) return;   // ignore double clicks on "Enter Site"
            ageLoaderRunning = true;

            var finished = false;
            function finish() {
                if (finished) return;       // make sure this only ever runs once
                finished = true;
                ageLoaderRunning = false;
                try { hidePageLoader(); } catch (ex) { }
                try {
                    if (typeof done === 'function') done();
                } catch (ex) {
                    console.error('Could not continue after the loading screen:', ex);
                }
            }

            try {
                var el = document.getElementById('pageLoader');
                if (!el) { finish(); return; }   // no loader on the page: skip straight to the next step
                el.style.display = 'flex';
                setTimeout(finish, AGE_LOADER_MS);
            } catch (ex) {
                console.error('Loading screen failed:', ex);
                finish();                        // never leave the visitor stuck on a blank page
            }
        }

        function showNewsletter() {
            document.getElementById('newsletterModal').classList.add('is-open');
        }

        function closeNewsletter() {
            document.getElementById('newsletterModal').classList.remove('is-open');
            document.getElementById('newsletterForm').style.display = 'block';
            document.getElementById('newsletterSuccess').style.display = 'none';
            document.getElementById('nlFirstName').value = '';
            document.getElementById('nlLastName').value = '';
            document.getElementById('nlEmail').value = '';
            showCookieBanner();
        }

        function submitNewsletter(e) {
            e.preventDefault();
            var first = document.getElementById('nlFirstName');
            var last = document.getElementById('nlLastName');
            var email = document.getElementById('nlEmail');
            var valid = true;

            document.getElementById('nlFirstNameError').textContent = '';
            document.getElementById('nlLastNameError').textContent = '';
            document.getElementById('nlEmailError').textContent = '';
            first.classList.remove('invalid');
            last.classList.remove('invalid');
            email.classList.remove('invalid');

            if (!first.value.trim()) {
                document.getElementById('nlFirstNameError').textContent = 'Please enter your first name.';
                first.classList.add('invalid');
                valid = false;
            }
            if (!last.value.trim()) {
                document.getElementById('nlLastNameError').textContent = 'Please enter your last name.';
                last.classList.add('invalid');
                valid = false;
            }
            var emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailPattern.test(email.value.trim())) {
                document.getElementById('nlEmailError').textContent = 'Please enter a valid email address.';
                email.classList.add('invalid');
                valid = false;
            }

            if (!valid) return false;

            var btn = e.currentTarget;
            var label = btn.textContent;
            btn.disabled = true;
            btn.textContent = 'Signing up...';

            newsletterSignup(first.value.trim(), last.value.trim(), email.value.trim(), function (ok, message) {
                btn.disabled = false;
                btn.textContent = label;
                if (ok) {
                    document.getElementById('newsletterForm').style.display = 'none';
                    document.getElementById('newsletterSuccess').style.display = 'block';
                } else {
                    document.getElementById('nlEmailError').textContent = message;
                    email.classList.add('invalid');
                }
            });
            return false;
        }

        // Shared by the popup and the footer form
        function newsletterSignup(first, last, email, done) {
            fetch('/NewsletterSignup.ashx', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'firstName=' + encodeURIComponent(first) +
                      '&lastName=' + encodeURIComponent(last) +
                      '&email=' + encodeURIComponent(email)
            })
                .then(function (res) { return res.json(); })
                .then(function (data) { done(!!data.ok, data.message); })
                .catch(function () { done(false, 'Something went wrong. Please try again.'); });
        }

        function toggleChatbot() {
            var panel = document.getElementById('chatbotPanel');
            panel.style.display = panel.style.display === 'none' ? 'flex' : 'none';
        }

        var chatAnswers = {
            hours: "We're open Mon–Thu 09:00–18:00, Fri–Sat 09:00–20:00, and Sun 10:00–15:00 (same on public holidays).",
            location: "You'll find us at 21 Coronation Road, Tongaat, Durban. There's a map in our footer!",
            delivery: "Yes! We offer same-day delivery in the Durban area on orders placed before 2pm.",
            loyalty: "Every purchase earns you points automatically once you're signed in — head to the Rewards page to see your balance and redeem discounts."
        };

        function askQuick(key) {
            var messages = document.getElementById('chatbotMessages');
            var questionText = document.querySelector('[onclick="askQuick(\'' + key + '\')"]').textContent;

            var userMsg = document.createElement('div');
            userMsg.className = 'chatbot-msg user';
            userMsg.textContent = questionText;
            messages.appendChild(userMsg);

            setTimeout(function () {
                var botMsg = document.createElement('div');
                botMsg.className = 'chatbot-msg bot';
                botMsg.textContent = chatAnswers[key];
                messages.appendChild(botMsg);
                messages.scrollTop = messages.scrollHeight;
            }, 400);

            messages.scrollTop = messages.scrollHeight;
        }

        function sendChatMessage(e) {
            e.preventDefault();
            var input = document.getElementById('chatbotInput');
            var messages = document.getElementById('chatbotMessages');
            if (!input.value.trim()) return false;

            var userMsg = document.createElement('div');
            userMsg.className = 'chatbot-msg user';
            userMsg.textContent = input.value;
            messages.appendChild(userMsg);

            input.value = '';

            setTimeout(function () {
                var text = userMsg.textContent.toLowerCase();
                var reply = "Thanks for your message! One of our team will get back to you shortly.";
                if (text.indexOf('hour') !== -1 || text.indexOf('open') !== -1) reply = chatAnswers.hours;
                else if (text.indexOf('where') !== -1 || text.indexOf('locat') !== -1 || text.indexOf('address') !== -1) reply = chatAnswers.location;
                else if (text.indexOf('deliver') !== -1) reply = chatAnswers.delivery;
                else if (text.indexOf('loyal') !== -1 || text.indexOf('reward') !== -1) reply = chatAnswers.loyalty;

                var botMsg = document.createElement('div');
                botMsg.className = 'chatbot-msg bot';
                botMsg.textContent = reply;
                messages.appendChild(botMsg);
                messages.scrollTop = messages.scrollHeight;
            }, 500);

            messages.scrollTop = messages.scrollHeight;
            return false;
        }

        function showCookieBanner() {
            if (localStorage.getItem('cookieConsent')) return;
            document.getElementById('cookieBanner').style.display = 'block';
        }

        function acceptCookies() {
            localStorage.setItem('cookieConsent', 'accepted');
            document.getElementById('cookieBanner').style.display = 'none';
        }

        function dismissCookieBanner() {
            localStorage.setItem('cookieConsent', 'dismissed');
            document.getElementById('cookieBanner').style.display = 'none';
        }

        function exitSite() {
            window.location.href = "https://www.google.com";
        }

        // Skip the gate if already verified this session
        window.addEventListener('DOMContentLoaded', function () {
            if (sessionStorage.getItem('ageVerified') === 'true') {
                document.getElementById('ageGate').style.display = "none";
            }
        });

        function toggleLang() {
            document.getElementById('langToggle').classList.toggle('active');
            // hook translation logic here later
        }

        function submitFooterNewsletter(e) {
            e.preventDefault();
            var first = document.getElementById('footerFirstName');
            var last = document.getElementById('footerLastName');
            var email = document.getElementById('footerEmail');
            var emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            var valid = true;

            document.getElementById('footerFirstNameError').textContent = '';
            document.getElementById('footerLastNameError').textContent = '';
            document.getElementById('footerEmailError').textContent = '';
            first.classList.remove('invalid');
            last.classList.remove('invalid');
            email.classList.remove('invalid');

            if (!first.value.trim()) {
                document.getElementById('footerFirstNameError').textContent = 'Required.';
                first.classList.add('invalid');
                valid = false;
            }
            if (!last.value.trim()) {
                document.getElementById('footerLastNameError').textContent = 'Required.';
                last.classList.add('invalid');
                valid = false;
            }
            if (!emailPattern.test(email.value.trim())) {
                document.getElementById('footerEmailError').textContent = 'Enter a valid email.';
                email.classList.add('invalid');
                valid = false;
            }
            if (!valid) return false;

            var btn = e.currentTarget;
            var label = btn.textContent;
            btn.disabled = true;
            btn.textContent = 'Signing up...';

            newsletterSignup(first.value.trim(), last.value.trim(), email.value.trim(), function (ok, message) {
                btn.disabled = false;
                btn.textContent = label;
                if (ok) {
                    first.value = ''; last.value = ''; email.value = '';
                    document.getElementById('footerNewsletterSuccess').style.display = 'block';
                    setTimeout(function () {
                        document.getElementById('footerNewsletterSuccess').style.display = 'none';
                    }, 5000);
                } else {
                    document.getElementById('footerEmailError').textContent = message;
                    email.classList.add('invalid');
                }
            });
            return false;
        }

        function togglePasswordVisibility() {
            var pwd = document.getElementById('txtPassword');
            var icon = document.getElementById('eyeIcon');
            if (pwd.type === 'password') {
                pwd.type = 'text';
                icon.innerHTML = '&#128584;';
            } else {
                pwd.type = 'password';
                icon.innerHTML = '&#128065;';
            }
        }

        function validateLoginForm() {
            var username = document.getElementById('txtUsername');
            var password = document.getElementById('txtPassword');
            var usernameError = document.getElementById('usernameError');
            var passwordError = document.getElementById('passwordError');
            var valid = true;

            usernameError.textContent = '';
            passwordError.textContent = '';
            username.classList.remove('invalid');
            password.classList.remove('invalid');

            if (!username.value.trim()) {
                usernameError.textContent = 'Email or username is required.';
                username.classList.add('invalid');
                valid = false;
            }
            if (!password.value.trim()) {
                passwordError.textContent = 'Password is required.';
                password.classList.add('invalid');
                valid = false;
            }

            return valid;
        }

        var pageLoaderTimer = null;

        // Loading screen: cycle through the shop's category names (read from the Shop menu in the header)
        (function () {
            var STEP_MS = 450; // time each name stays up: lower = faster

            function init() {
                try {
                    var box = document.getElementById('loaderTagline');
                    if (!box) return;

                    var names = [];
                    document.querySelectorAll('.nav-links .has-dropdown:first-child .dropdown-menu a:not(.dropdown-view-all)').forEach(function (a) {
                        var n = (a.textContent || '').replace(/\s+/g, ' ').trim();
                        if (n && n.length <= 28 && names.indexOf(n) === -1) names.push(n);
                    });
                    if (names.length < 2) names = ['Spirits', 'Wine', 'Beer', 'Whisky'];
                    names = names.slice(0, 12);

                    box.innerHTML = '';
                    names.forEach(function (n) {
                        var s = document.createElement('span');
                        s.textContent = n; // set as text, never as HTML
                        box.appendChild(s);
                    });

                    var spans = box.querySelectorAll('span');
                    var i = 0;
                    spans[0].classList.add('is-on');

                    // Only moves on while the loading screen is actually showing
                    setInterval(function () {
                        var overlay = document.getElementById('pageLoader');
                        if (!overlay || overlay.style.display === 'none') return;
                        spans[i].classList.remove('is-on');
                        i = (i + 1) % spans.length;
                        spans[i].classList.add('is-on');
                    }, STEP_MS);
                } catch (ex) { /* the tagline is cosmetic: leave the default word */ }
            }

            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
            else init();
        })();

        // How long the loading screen stays up at minimum, in milliseconds (2000 = 2 seconds)
        var PAGE_LOADER_MIN_MS = 2000;

        function showPageLoader() {
            var el = document.getElementById('pageLoader');
            if (!el) return;
            el.style.display = 'flex';
            // The next page reads this and keeps the loader up until this time
            try { sessionStorage.setItem('loaderUntil', String(Date.now() + PAGE_LOADER_MIN_MS)); } catch (ex) { }
            clearTimeout(pageLoaderTimer);
            // If the page never changes (a download, a blocked navigation), don't leave the overlay stuck
            pageLoaderTimer = setTimeout(hidePageLoader, 15000);
        }

        function hidePageLoader() {
            var el = document.getElementById('pageLoader');
            if (el) el.style.display = 'none';
            clearTimeout(pageLoaderTimer);
        }

        // Show the loader the moment someone clicks a link that opens another page on this site.
        // The animation itself is the #pageLoader markup above plus .loading-overlay in Site.css,
        // so it can be restyled later without touching this code.
        document.addEventListener('click', function (e) {
            try {
                if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
                var link = e.target && e.target.closest ? e.target.closest('a[href]') : null;
                if (!link) return;

                var href = link.getAttribute('href');
                if (!href || href.charAt(0) === '#' || /^(javascript|mailto|tel|sms):/i.test(href)) return;
                if (link.target && link.target !== '_self') return;           // opens in a new tab
                if (link.hasAttribute('download')) return;                    // a file download
                if (link.origin !== window.location.origin) return;           // another website
                if (link.hash && link.pathname === window.location.pathname && link.search === window.location.search) return; // jump within this page

                showPageLoader();
            } catch (ex) { /* the loader is cosmetic: never block a link */ }
        });

        // Safety net: if the user navigates back via the browser's
        // back/forward cache, the old page (with loader still visible)
        // can be restored instantly — make sure it's hidden again.
        window.addEventListener('pageshow', function (e) {
            if (e.persisted) hidePageLoader();
        });

        // ===== Loading screen: only for slow pages, and never before the age check =====
        var PAGE_LOADER_DELAY_MS = 700; // how long a page must take before the loading screen appears
        var pageLoaderShowTimer = null;
        var pageLoaderHideTimer = null;

        function showPageLoader() {
            try {
                // Not while the age gate is showing, or before age has been confirmed
                if (sessionStorage.getItem('ageVerified') !== 'true') return;
                var gate = document.getElementById('ageGate');
                if (gate && gate.style.display !== 'none') return;
            } catch (ex) { }

            var el = document.getElementById('pageLoader');
            if (!el) return;

            clearTimeout(pageLoaderShowTimer);
            clearTimeout(pageLoaderHideTimer);
            // Fast pages arrive before this fires, so they never show the loading screen
            pageLoaderShowTimer = setTimeout(function () {
                el.style.display = 'flex';
                // If the page never changes (a download, a blocked navigation), don't leave it stuck
                pageLoaderHideTimer = setTimeout(hidePageLoader, 15000);
            }, PAGE_LOADER_DELAY_MS);
        }

        function hidePageLoader() {
            clearTimeout(pageLoaderShowTimer);
            clearTimeout(pageLoaderHideTimer);
            var el = document.getElementById('pageLoader');
            if (el) el.style.display = 'none';
        }

        // ===== Dashboard charts =====
        // A page declares a chart as <canvas data-chart="{type, labels, values, money}">.
        // type is 'bar' (columns), 'hbar' (horizontal bars) or 'doughnut'.
        // Chart.js is only downloaded on pages that actually have a chart, and every
        // chart is redrawn when the theme toggles so text and gridlines stay readable.
        (function () {
            var canvases = document.querySelectorAll('canvas[data-chart]');
            if (!canvases.length) return;

            var charts = [];

            // Doughnut colours were checked for colour-blind separation in both themes.
            // Doughnuts are capped at 3 slices + a grey "Other" because blue/amber fail past that.
            function themeColours() {
                var dark = document.documentElement.getAttribute('data-theme') === 'dark';
                return dark
                    ? { bar: '#3987e5', barSoft: '#1f4f8f', series: ['#3987e5', '#a67f2e', '#d55181'], other: '#636366', text: '#9a9aa2', grid: 'rgba(255,255,255,0.06)', surface: '#1a1f2c' }
                    : { bar: '#0a84ff', barSoft: '#7cc4ff', series: ['#0a84ff', '#c9a24b', '#e87ba4'], other: '#aeaeb2', text: '#6e6e73', grid: 'rgba(0,0,0,0.05)', surface: '#f7f9fc' };
            }

            var tooltipStyle = { backgroundColor: 'rgba(29,29,31,0.92)', padding: 10, cornerRadius: 10, displayColors: false, titleFont: { weight: '600' } };

            // Bars fade from a lighter blue at the baseline to the brand blue at the tip
            function barGradient(c, horizontal) {
                return function (ctx) {
                    var area = ctx.chart.chartArea;
                    if (!area) return c.bar;
                    var g = horizontal
                        ? ctx.chart.ctx.createLinearGradient(area.left, 0, area.right, 0)
                        : ctx.chart.ctx.createLinearGradient(0, area.bottom, 0, area.top);
                    g.addColorStop(0, c.barSoft);
                    g.addColorStop(1, c.bar);
                    return g;
                };
            }

            function formatRand(v, decimals) {
                return 'R' + Number(v).toLocaleString('en-ZA', { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
            }

            function formatAxis(v, money) {
                if (!money) return v;
                return Math.abs(v) >= 1000 ? 'R' + (v / 1000).toLocaleString('en-ZA', { maximumFractionDigits: 1 }) + 'k' : 'R' + v;
            }

            function foldToTop3(labels, values) {
                if (labels.length <= 3) return { labels: labels, values: values };
                var rest = values.slice(3).reduce(function (a, b) { return a + b; }, 0);
                return { labels: labels.slice(0, 3).concat(['Other']), values: values.slice(0, 3).concat([rest]) };
            }

            function buildLegend(canvas, labels, values, colours, money) {
                var card = canvas.closest('.mgr-chart-card');
                var legend = card ? card.querySelector('.dash-legend') : null;
                if (!legend) return;
                var total = values.reduce(function (a, b) { return a + b; }, 0) || 1;
                legend.innerHTML = labels.map(function (label, i) {
                    var pct = Math.round(values[i] / total * 100);
                    return '<li class="dash-legend-item"><span class="dash-legend-swatch" style="background:' + colours[i] + '"></span>' +
                        '<span class="dash-legend-label"></span>' +
                        '<span class="dash-legend-value">' + pct + '%' + (money ? ' · ' + formatRand(values[i], 0) : '') + '</span></li>';
                }).join('');
                // Labels come from the database, so set them as text rather than HTML
                legend.querySelectorAll('.dash-legend-label').forEach(function (el, i) { el.textContent = labels[i]; });
            }

            function renderChart(canvas) {
                var spec = JSON.parse(canvas.getAttribute('data-chart'));
                var c = themeColours();
                var values = (spec.values || []).map(Number);
                var hasData = values.some(function (v) { return v > 0; });

                var wrap = canvas.parentNode;
                var empty = wrap.querySelector('.dash-empty');
                if (!hasData) {
                    canvas.style.display = 'none';
                    if (!empty) {
                        empty = document.createElement('p');
                        empty.className = 'dash-empty';
                        empty.textContent = canvas.getAttribute('data-empty') || 'No sales in this period';
                        wrap.appendChild(empty);
                    }
                    return;
                }

                Chart.defaults.color = c.text;
                Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;

                if (spec.type === 'doughnut') {
                    var folded = foldToTop3(spec.labels, values);
                    var colours = folded.labels.map(function (label, i) { return i < 3 ? c.series[i] : c.other; });
                    buildLegend(canvas, folded.labels, folded.values, colours, spec.money);
                    charts.push(new Chart(canvas, {
                        type: 'doughnut',
                        data: { labels: folded.labels, datasets: [{ data: folded.values, backgroundColor: colours, borderColor: c.surface, borderWidth: 2 }] },
                        options: {
                            cutout: '62%', maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: Object.assign({}, tooltipStyle, { callbacks: { label: function (ctx) { return ctx.label + ': ' + (spec.money ? formatRand(ctx.parsed, 2) : ctx.parsed); } } })
                            }
                        }
                    }));
                    return;
                }

                var horizontal = spec.type === 'hbar';
                var valueAxis = { grid: { color: c.grid }, border: { display: false }, beginAtZero: true, ticks: { callback: function (v) { return formatAxis(v, spec.money); } } };
                // Long product names would be clipped at the canvas edge, so shorten them (the tooltip still shows the full name)
                var categoryAxis = {
                    grid: { display: false }, border: { display: false },
                    ticks: horizontal
                        ? { callback: function (v) { var label = this.getLabelForValue(v); return label.length > 22 ? label.slice(0, 21) + '…' : label; } }
                        : { autoSkip: true, maxRotation: 0 }
                };

                charts.push(new Chart(canvas, {
                    type: 'bar',
                    data: { labels: spec.labels, datasets: [{ data: values, backgroundColor: barGradient(c, horizontal), hoverBackgroundColor: c.bar, borderRadius: 6, maxBarThickness: 26 }] },
                    options: {
                        indexAxis: horizontal ? 'y' : 'x', maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: Object.assign({}, tooltipStyle, { callbacks: { title: function (items) { return items[0].label; }, label: function (ctx) { var v = horizontal ? ctx.parsed.x : ctx.parsed.y; return spec.money ? formatRand(v, 2) : v.toLocaleString('en-ZA'); } } })
                        },
                        scales: horizontal ? { x: valueAxis, y: categoryAxis } : { x: categoryAxis, y: valueAxis }
                    }
                }));
            }

            function renderAll() {
                charts.forEach(function (ch) { ch.destroy(); });
                charts = [];
                canvases.forEach(renderChart);
            }

            var script = document.createElement('script');
            script.src = '/Scripts/chart.umd.min.js';
            script.onload = function () {
                renderAll();
                new MutationObserver(renderAll).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
            };
            document.body.appendChild(script);
        })();

        // ===== Management page helpers (Manage Customers, Manage Sales, cashier Orders) =====

        // Confirmation dialog for grid buttons. Use as OnClientClick="return dashConfirm(this, title, text, okLabel, danger);"
        // The page supplies the #dashModal markup; the button's postback runs only after OK is clicked.
        var dashPendingAction = null;

        function dashConfirm(link, title, text, okLabel, danger) {
            var modal = document.getElementById('dashModal');
            if (!modal) return true;
            dashPendingAction = link.getAttribute('href');
            document.getElementById('dashModalTitle').textContent = title;
            document.getElementById('dashModalText').textContent = text;
            var ok = document.getElementById('dashModalOk');
            ok.textContent = okLabel;
            ok.className = 'btn-primary' + (danger ? ' emp-btn-danger' : '');
            modal.classList.add('is-open');
            return false;
        }

        function dashModalClose() {
            var modal = document.getElementById('dashModal');
            if (modal) modal.classList.remove('is-open');
            dashPendingAction = null;
        }

        document.addEventListener('click', function (e) {
            if (!e.target || e.target.id !== 'dashModalOk') return;
            var js = dashPendingAction;
            dashModalClose();
            if (js) { new Function(js.replace(/^javascript:/i, ''))(); }
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') dashModalClose();
        });

        // Live search: a box with data-live-search="<button client ID>" clicks that button 350ms after typing stops.
        // Inputs marked data-digits / data-phone strip characters that can't belong in an ID number or phone number.
        var dashSearchTimer = null;
        document.addEventListener('input', function (e) {
            var t = e.target;
            if (!t || !t.getAttribute) return;

            var buttonId = t.getAttribute('data-live-search');
            if (buttonId) {
                clearTimeout(dashSearchTimer);
                dashSearchTimer = setTimeout(function () {
                    var b = document.getElementById(buttonId);
                    if (b) b.click();
                }, 350);
            }
            if (t.getAttribute('data-digits')) t.value = t.value.replace(/[^0-9]/g, '');
            if (t.getAttribute('data-phone')) t.value = t.value.replace(/(?!^\+)[^0-9]/g, '');
        });

        // Success messages fade out after 5 seconds, including ones shown by an UpdatePanel refresh.
        // After a partial refresh the search box is replaced, so put the cursor back where the user was typing.
        function dashAfterLoad() {
            var a = document.querySelector('.emp-alert-success');
            if (a && !a.getAttribute('data-timer')) {
                a.setAttribute('data-timer', '1');
                setTimeout(function () {
                    a.classList.add('is-hiding');
                    setTimeout(function () { if (a.parentNode) a.parentNode.removeChild(a); }, 450);
                }, 5000);
            }

            var search = document.querySelector('[data-live-search]');
            if (search && window.dashRefocusSearch) {
                window.dashRefocusSearch = false;
                search.focus();
                var end = search.value.length;
                search.setSelectionRange(end, end);
            }
        }

        document.addEventListener('focusin', function (e) {
            window.dashRefocusSearch = !!(e.target && e.target.getAttribute && e.target.getAttribute('data-live-search'));
        });

        if (window.Sys && Sys.Application) {
            Sys.Application.add_load(dashAfterLoad);
        } else {
            document.addEventListener('DOMContentLoaded', dashAfterLoad);
        }

        // ===== Back-to-top button (bottom right, left of the chatbot) =====
        (function () {
            var btn = document.getElementById('backToTop');
            if (!btn) return;
            function update() { btn.classList.toggle('is-visible', window.scrollY > 400); }
            window.addEventListener('scroll', update, { passive: true });
            update();
            btn.addEventListener('click', function () {
                var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
            });
        })();

        // ===== Low-stock pop-up (Manager dashboard, once per login) =====
        // Hides after 10s; hovering or focusing inside it pauses the countdown.
        (function () {
            var toast = document.getElementById('stockToast');
            if (!toast) return;
            var remaining = 10000, started = 0, timer = null;
            function hide() { toast.classList.remove('is-open'); clearTimeout(timer); }
            function start() { clearTimeout(timer); started = Date.now(); timer = setTimeout(hide, Math.max(remaining, 1500)); }
            function pause() { clearTimeout(timer); remaining -= Date.now() - started; }
            toast.addEventListener('mouseenter', pause);
            toast.addEventListener('mouseleave', start);
            toast.addEventListener('focusin', pause);
            toast.addEventListener('focusout', start);
            toast.querySelector('.stock-toast-close').addEventListener('click', hide);
            setTimeout(function () {
                // Sit above the cookie banner if it's showing in the same corner
                var cookie = document.getElementById('cookieBanner');
                // (offsetParent is always null for fixed elements, so check for a rendered box instead)
                if (cookie && cookie.getClientRects().length > 0) toast.style.bottom = (cookie.offsetHeight + 36) + 'px';
                toast.classList.add('is-open');
                start();
            }, 600);
        })();

        // ===== Receipts: links ending in &print=1 open the print window straight away =====
        if (document.querySelector('[data-autoprint]')) {
            window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 300); });
        }
    </script>
    <% if (Context.Session != null && Session["UserRole"] != null) { %>
    <script>
        // Lets the server tell "tab closed" apart from "moved to another page".
        (function () {
            function ping(action) {
                try { navigator.sendBeacon('/SessionBeacon.ashx?a=' + action); } catch (e) { }
            }
            ping('alive');
            setInterval(function () { ping('alive'); }, 30000);
            window.addEventListener('pagehide', function () { ping('close'); });
        })();
    </script>
    <% } %>
</body>
</html>
