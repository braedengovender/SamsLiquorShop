<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="SamsLiquorShop.SiteMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <script>
        (function () {
            var theme = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> | Sam's Liquor Shop</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>
    <webopt:bundlereference runat="server" path="~/Content/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

</head>
<body>
    <div id="ageGate" class="age-gate" style="display:none;">
      <div class="glass age-card">
          <img src="/Images/logo-cropped.png" alt="Sam's Liquor Shop" class="age-card-logo" />
        <p class="age-eyebrow">Sam's Liquor Shop supports the responsible consumption of alcohol.</p>
        <p class="age-question">If you are of legal drinking age, please confirm your date of birth to enter.</p>

        <div class="dob-row">
          <select id="dobDay" class="dob-select"><option value="">Day</option></select>
          <select id="dobMonth" class="dob-select"><option value="">Month</option></select>
          <select id="dobYear" class="dob-select"><option value="">Year</option></select>
        </div>

        <p id="ageError" class="age-error" style="display:none;"></p>

        <div class="age-buttons">
          <button type="button" class="btn-primary" onclick="verifyAge()">Enter Site</button>
          <button type="button" class="btn-ghost age-exit" onclick="exitSite()">No, Get Me Out</button>
        </div>

        <img src="/Images/responsible-drinking.jpg" alt="Drink responsibly" class="age-image" />
      </div>
    </div>
    <script>
        if (sessionStorage.getItem('ageVerified') !== 'true') {
            document.getElementById('ageGate').style.display = 'flex';
        }
    </script>

    <div id="newsletterModal" class="newsletter-overlay">
      <div class="glass newsletter-card">
        <button type="button" class="newsletter-close" onclick="closeNewsletter()" aria-label="Close">&times;</button>

        <div class="newsletter-visual">
          <svg class="newsletter-decor" viewBox="0 0 300 400" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <g fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.85">
              <path d="M 130 30 L 130 60 Q 130 68 120 76 Q 100 92 100 118 L 100 340 Q 100 358 118 358 L 182 358 Q 200 358 200 340 L 200 118 Q 200 92 180 76 Q 170 68 170 60 L 170 30 Z" />
              <rect x="126" y="14" width="48" height="18" rx="4" />
              <line x1="100" y1="180" x2="200" y2="180" stroke-width="1.2" opacity="0.5" />
            </g>
            <g clip-path="url(#nlBottleClip)">
              <rect x="100" y="358" width="100" height="140" fill="var(--accent-amber)" opacity="0.4" />
            </g>
            <defs>
              <clipPath id="nlBottleClip">
                <path d="M 100 180 L 100 340 Q 100 358 118 358 L 182 358 Q 200 358 200 340 L 200 180 Z" />
              </clipPath>
            </defs>
          </svg>
          <p class="newsletter-visual-tag">Sam's Liquor Shop</p>
          <h2 class="newsletter-visual-heading">Welcome to Durban's Finest Drinks Selection</h2>
          <p class="newsletter-visual-sub">From spirits to global wines — your journey starts here.</p>
        </div>

        <div class="newsletter-form-side">
          <p class="newsletter-form-eyebrow">Join Our Community</p>
          <p class="newsletter-form-lead">Sign up and be the first to hear about new arrivals, tastings, and exclusive offers.</p>

          <div id="newsletterForm" class="newsletter-form">
            <div class="form-row">
              <div class="form-group">
                <input type="text" id="nlFirstName" placeholder="First name" />
                <span class="field-error" id="nlFirstNameError"></span>
              </div>
              <div class="form-group">
                <input type="text" id="nlLastName" placeholder="Last name" />
                <span class="field-error" id="nlLastNameError"></span>
              </div>
            </div>
            <div class="form-group">
              <input type="email" id="nlEmail" placeholder="Email address" />
              <span class="field-error" id="nlEmailError"></span>
            </div>
            <button type="button" class="btn-primary newsletter-submit" onclick="submitNewsletter(event)">Sign Up</button>
            <p class="newsletter-terms">
              By signing up, you agree to receive marketing emails. View our
              <a href="PrivacyPolicy.aspx">privacy policy</a> and <a href="TermsOfService.aspx">terms of service</a>.
            </p>
          </div>
          <div id="newsletterSuccess" class="newsletter-success" style="display:none;">
            <div class="newsletter-success-icon">&#10003;</div>
            <h3>You're in!</h3>
            <p>Thanks for signing up - keep an eye on your inbox for new arrivals, tastings, and exclusive offers.</p>
            <button type="button" class="btn-primary" onclick="closeNewsletter()">Continue Browsing</button>
          </div>
        </div>

      </div>
    </div>

    <div class="chatbot-widget">
      <div id="chatbotPanel" class="glass chatbot-panel" style="display:none;">
        <div class="chatbot-header">
          <img src="/Images/cartIcon.png" alt="Sam's Liquor Shop" class="chatbot-header-logo" />
          <span>Sam's Assistant</span>
        </div>
        <div id="chatbotMessages" class="chatbot-messages">
          <div class="chatbot-msg bot">Cheers for stopping by! 🥂 Ask me anything, or tap a question below.</div>
          <div class="chatbot-quick-replies">
            <button type="button" class="quick-reply" onclick="askQuick('hours')">What are your trading hours?</button>
            <button type="button" class="quick-reply" onclick="askQuick('location')">Where are you located?</button>
            <button type="button" class="quick-reply" onclick="askQuick('delivery')">Do you deliver?</button>
            <button type="button" class="quick-reply" onclick="askQuick('loyalty')">How does the loyalty card work?</button>
          </div>
        </div>
        <div class="chatbot-input-row">
          <input type="text" id="chatbotInput" placeholder="Type a message..." onkeypress="if(event.key==='Enter'){sendChatMessage(event);}" />
          <button type="button" onclick="sendChatMessage(event)">&rarr;</button>
        </div>
      </div>
      <button type="button" class="chatbot-toggle glass" onclick="toggleChatbot()" aria-label="Chat with us">
        <img src="/Images/chatbot-icon.png" alt="Chat" class="chatbot-toggle-logo" />
      </button>
    </div>

    <div id="cookieBanner" class="cookie-banner" style="display:none;">
      <div class="glass cookie-card">
        <p>We value your privacy. We use cookies to enhance your browsing experience, serve personalised ads or content, and analyse our traffic. By clicking "Accept All", you consent to our use of cookies.</p>
        <div class="cookie-actions">
          <button type="button" class="btn-ghost cookie-decline" onclick="dismissCookieBanner()">Decline</button>
          <button type="button" class="btn-primary" onclick="acceptCookies()">Accept All</button>
        </div>
      </div>
    </div>

    <div id="pageLoader" class="loading-overlay" style="display: none;">
        <div class="loading-spinner"></div>
        <p>Loading&hellip;</p>
    </div>

