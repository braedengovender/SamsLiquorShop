<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="SamsLiquorShop.SiteMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> | Sam's Liquor Shop</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>
    <webopt:bundlereference runat="server" path="~/Content/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

</head>
<body>
    <div id="ageGate" class="age-gate">
      <div class="glass age-card">
          <img src="Images/logo.png" alt="Sam's Liquor Shop" class="age-card-logo" />
        <p class="age-eyebrow">Sam's Liquor Shop supports the responsible consumption of alcohol.</p>
        <p class="age-question">If you are of legal drinking age, please confirm your date of birth to enter.</p>

        <div class="dob-row">
          <select id="dobDay" class="dob-select"><option value="">Day</option></select>
          <select id="dobMonth" class="dob-select"><option value="">Month</option></select>
          <select id="dobYear" class="dob-select"><option value="">Year</option></select>
        </div>

        <p id="ageError" class="age-error" style="display:none;"></p>

        <div class="age-buttons">
          <button type="button" class="btn-primary" onclick="verifyAge()">Enter Site</button>
          <button type="button" class="btn-ghost age-exit" onclick="exitSite()">No, Get Me Out</button>
        </div>

        <img src="Images/responsible-drinking.jpg" alt="Drink responsibly" class="age-image" />
      </div>
    </div>

    <div id="newsletterModal" class="newsletter-overlay" style="display:none;">
      <div class="glass newsletter-card">
        <button type="button" class="newsletter-close" onclick="closeNewsletter()" aria-label="Close">&times;</button>
        <div class="newsletter-content">
          <p class="newsletter-eyebrow">Sam's Liquor Shop</p>
          <h2 class="newsletter-heading">Welcome to Durban's Finest Drinks Selection</h2>
          <p class="newsletter-sub">From spirits to global wines — your journey starts here. Sign up to join our global community.</p>

          <form id="newsletterForm" class="newsletter-form" onsubmit="return submitNewsletter(event)">
            <div class="form-row">
              <div class="form-group">
                <input type="text" id="nlFirstName" placeholder="First name" />
                <span class="field-error" id="nlFirstNameError"></span>
              </div>
              <div class="form-group">
                <input type="text" id="nlLastName" placeholder="Last name" />
                <span class="field-error" id="nlLastNameError"></span>
              </div>
            </div>
            <div class="form-group">
              <input type="email" id="nlEmail" placeholder="Email address" />
              <span class="field-error" id="nlEmailError"></span>
            </div>
            <button type="submit" class="btn-primary newsletter-submit">Sign Up</button>
            <p class="newsletter-terms">
              By signing up, you agree to receive marketing emails. View our
              <a href="PrivacyPolicy.aspx">privacy policy</a> and <a href="TermsOfService.aspx">terms of service</a> for more information.
            </p>
          </form>
        </div>
      </div>
    </div>

    <div class="chatbot-widget">
      <div id="chatbotPanel" class="glass chatbot-panel" style="display:none;">
        <div class="chatbot-header">
          <img src="Images/logo.png" alt="Sam's Liquor Shop" class="chatbot-header-logo" />
          <span>Sam's Assistant</span>
        </div>
        <div id="chatbotMessages" class="chatbot-messages">
          <div class="chatbot-msg bot">Cheers for stopping by! 🥂 Ask me anything and I'll do my best to help.</div>
        </div>
        <form class="chatbot-input-row" onsubmit="return sendChatMessage(event)">
          <input type="text" id="chatbotInput" placeholder="Type a message..." />
          <button type="submit">&rarr;</button>
        </form>
      </div>
      <button type="button" class="chatbot-toggle glass" onclick="toggleChatbot()" aria-label="Chat with us">
        <img src="Images/logo-icon.png" alt="Chat" class="chatbot-toggle-logo" />
      </button>
    </div>

    <div id="cookieBanner" class="cookie-banner" style="display:none;">
      <div class="glass cookie-card">
        <p>We value your privacy. We use cookies to enhance your browsing experience, serve personalised ads or content, and analyse our traffic. By clicking "Accept All", you consent to our use of cookies.</p>
        <div class="cookie-actions">
          <button type="button" class="btn-ghost cookie-decline" onclick="dismissCookieBanner()">Decline</button>
          <button type="button" class="btn-primary" onclick="acceptCookies()">Accept All</button>
        </div>
      </div>
    </div>

    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <%--To learn more about bundling scripts in ScriptManager see https://go.microsoft.com/fwlink/?LinkID=301884 --%>
                <%--Framework Scripts--%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
                <%--Site Scripts--%>
            </Scripts>
        </asp:ScriptManager>

        <header class="site-header shell">
          <nav class="glass nav-bar">
            <div class="brand">Sam's Liquor Shop</div>
            <ul class="nav-links">
              <li><a href="~/Default.aspx" runat="server">Home</a></li>
              <li><a href="~/Shop.aspx" runat="server">Shop</a></li>
              <li><a href="~/Specials.aspx" runat="server">Specials</a></li>
              <li><a href="~/Shipping.aspx" runat="server">Shipping</a></li>
              <li><a href="~/Rewards.aspx" runat="server">Rewards</a></li>
              <li><a href="~/About.aspx" runat="server">About Us</a></li>
              <li><a href="~/Contact.aspx" runat="server">Contact</a></li>
            </ul>
            <div class="nav-auth">
              <a runat="server" href="~/Account/Login" class="btn-ghost">Log in</a>
              <a runat="server" href="~/Account/Register" class="btn-primary">Register</a>
            </div>
          </nav>
        </header>

        <div class="shell body-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </div>

        <section class="shell site-footer-main">
          <div class="footer-top">
            <div class="footer-brand">
              <img src="Images/logo.png" alt="Sam's Liquor Shop" class="footer-logo" />
              <p class="footer-tagline">Durban's trusted liquor store — spirits, wine and more, delivered right.</p>
              <address>
                21 Coronation Road<br />
                Tongaat, Durban, 4399<br />
                KwaZulu-Natal
              </address>
              <p><a href="tel:+27824055932">082 405 5932</a></p>
              <p><a href="mailto:info@samsliquorshop.co.za">info@samsliquorshop.co.za</a></p>
              <div class="footer-map">
                <iframe
                  src="https://www.google.com/maps?q=21+Coronation+Road,+Tongaat,+4399&output=embed"
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade">
                </iframe>
              </div>
            </div>

            <div class="footer-col">
              <h3>Helpful Links</h3>
              <ul>
                <li><a href="Loyalty.aspx">Loyalty &amp; Rewards</a></li>
                <li><a href="Loyalty.aspx#card">Get the Loyalty Card</a></li>
                <li><a href="WishList.aspx">Wish List</a></li>
                <li><a href="Account/Profile.aspx">My Profile</a></li>
                <li><a href="Account/Orders.aspx">My Orders</a></li>
                <li><a href="Account/Settings.aspx">Settings</a></li>
              </ul>
            </div>

            <div class="footer-col">
              <h3>Policies</h3>
              <ul>
                <li><a href="DeliveryPolicy.aspx">Delivery Policy</a></li>
                <li><a href="ReturnPolicy.aspx">Return Policy</a></li>
                <li><a href="PrivacyPolicy.aspx">Privacy Policy</a></li>
                <li><a href="CookiesPolicy.aspx">Cookies Policy</a></li>
                <li><a href="Terms.aspx">Terms &amp; Conditions</a></li>
                <li><a href="WebsiteTerms.aspx">Website Terms of Use</a></li>
                <li><a href="FAQ.aspx">FAQ</a></li>
              </ul>
            </div>

            <div class="footer-col">
              <h3>Trading Hours</h3>
              <ul class="hours-list">
                <li><span>Mon – Thu</span><span>09:00 – 18:00</span></li>
                <li><span>Fri – Sat</span><span>09:00 – 20:00</span></li>
                <li><span>Sunday</span><span>10:00 – 15:00</span></li>
                <li><span>Public Holidays</span><span>10:00 – 15:00</span></li>
              </ul>
              <p class="hours-note">Trading hours may vary in accordance with liquor licensing regulations.</p>
            </div>
          </div>

          <div class="footer-newsletter-band">
            <div class="newsletter-band-text">
              <h3>Be the first to know!</h3>
              <p>Sign up for our newsletter for the latest deals and what's new.</p>
            </div>
            <form class="footer-newsletter-form" onsubmit="return submitFooterNewsletter(event)">
              <div class="footer-field">
                <input type="text" placeholder="First name" id="footerFirstName" class="footer-input" />
                <span class="field-error" id="footerFirstNameError"></span>
              </div>
              <div class="footer-field">
                <input type="text" placeholder="Last name" id="footerLastName" class="footer-input" />
                <span class="field-error" id="footerLastNameError"></span>
              </div>
              <div class="footer-field">
                <input type="email" placeholder="Email address" id="footerEmail" class="footer-input" />
                <span class="field-error" id="footerEmailError"></span>
              </div>
              <button type="submit" class="btn-primary">Sign Up</button>
            </form>
            <p class="footer-newsletter-privacy">How do we use your information? Read our <a href="PrivacyPolicy.aspx">privacy policy</a>.</p>
          </div>
        </section>

        <footer class="shell footer-stack">
          <div class="glass footer-credit">
            <p>&copy; 2026 Sam's Liquor Shop - All Rights Reserved. Designed by The Byte Club.</p>
          </div>
          <div class="glass footer-responsible">
            <img src="Images/responsible-drinking.jpg" alt="Please drink responsibly" />
          </div>
          <div class="glass footer-info">
            <div class="footer-security">
              <span class="lock-icon">&#128274;</span>
              <span>100% Secure Checkout</span>
            </div>
            <div class="footer-payments">
              <span class="payments-label">Approved payment methods</span>
              <div class="payment-icons">
                <img src="Images/payments/visa.svg" alt="Visa" />
                <img src="Images/payments/mastercard.svg" alt="Mastercard" />
                <img src="Images/payments/debit.svg" alt="Debit Card" />
              </div>
            </div>
            <div class="footer-lang">
              <span>English</span>
              <button type="button" id="langToggle" class="lang-toggle" onclick="toggleLang()">
                <span class="lang-knob"></span>
              </button>
              <span>isiZulu</span>
            </div>
          </div>
</footer>
    </form>
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>
    <script>
        (function populateDobDropdowns() {
            var daySel = document.getElementById('dobDay');
            var monthSel = document.getElementById('dobMonth');
            var yearSel = document.getElementById('dobYear');

            for (var d = 1; d <= 31; d++) {
                daySel.innerHTML += '<option value="' + d + '">' + d + '</option>';
            }

            var months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
            for (var m = 0; m < months.length; m++) {
                monthSel.innerHTML += '<option value="' + (m + 1) + '">' + months[m] + '</option>';
            }

            var currentYear = new Date().getFullYear();
            for (var y = currentYear; y >= currentYear - 100; y--) {
                yearSel.innerHTML += '<option value="' + y + '">' + y + '</option>';
            }
        })();

        function verifyAge() {
            var day = document.getElementById('dobDay').value;
            var month = document.getElementById('dobMonth').value;
            var year = document.getElementById('dobYear').value;
            var errorEl = document.getElementById('ageError');

            if (!day || !month || !year) {
                errorEl.textContent = "Please select your full date of birth.";
                errorEl.style.display = "block";
                return;
            }

            var dob = new Date(year, month - 1, day);
            var today = new Date();
            var age = today.getFullYear() - dob.getFullYear();
            var m = today.getMonth() - dob.getMonth();
            if (m < 0 || (m === 0 && today.getDate() < dob.getDate())) {
                age--;
            }

            if (age < 18) {
                errorEl.textContent = "You must be 18 or older to enter this site.";
                errorEl.style.display = "block";
                return;
            }

            errorEl.style.display = "none";
            document.getElementById('ageGate').style.display = "none";
            sessionStorage.setItem('ageVerified', 'true');
            showNewsletter();
        }

        function showNewsletter() {
            document.getElementById('newsletterModal').style.display = 'flex';
        }

        function closeNewsletter() {
            document.getElementById('newsletterModal').style.display = 'none';
            showCookieBanner();
        }

        function submitNewsletter(e) {
            e.preventDefault();
            var first = document.getElementById('nlFirstName');
            var last = document.getElementById('nlLastName');
            var email = document.getElementById('nlEmail');
            var valid = true;

            document.getElementById('nlFirstNameError').textContent = '';
            document.getElementById('nlLastNameError').textContent = '';
            document.getElementById('nlEmailError').textContent = '';
            first.classList.remove('invalid');
            last.classList.remove('invalid');
            email.classList.remove('invalid');

            if (!first.value.trim()) {
                document.getElementById('nlFirstNameError').textContent = 'Please enter your first name.';
                first.classList.add('invalid');
                valid = false;
            }
            if (!last.value.trim()) {
                document.getElementById('nlLastNameError').textContent = 'Please enter your last name.';
                last.classList.add('invalid');
                valid = false;
            }
            var emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailPattern.test(email.value.trim())) {
                document.getElementById('nlEmailError').textContent = 'Please enter a valid email address.';
                email.classList.add('invalid');
                valid = false;
            }

            if (!valid) return false;

            // TODO: wire this to your sign-up endpoint / code-behind method
            closeNewsletter();
            return false;
        }

        function toggleChatbot() {
            var panel = document.getElementById('chatbotPanel');
            panel.style.display = panel.style.display === 'none' ? 'flex' : 'none';
        }

        function sendChatMessage(e) {
            e.preventDefault();
            var input = document.getElementById('chatbotInput');
            var messages = document.getElementById('chatbotMessages');
            if (!input.value.trim()) return false;

            var userMsg = document.createElement('div');
            userMsg.className = 'chatbot-msg user';
            userMsg.textContent = input.value;
            messages.appendChild(userMsg);

            input.value = '';

            setTimeout(function () {
                var botMsg = document.createElement('div');
                botMsg.className = 'chatbot-msg bot';
                botMsg.textContent = "Thanks for your message! One of our team will get back to you shortly — in the meantime, feel free to browse our Specials page.";
                messages.appendChild(botMsg);
                messages.scrollTop = messages.scrollHeight;
            }, 500);

            messages.scrollTop = messages.scrollHeight;
            return false;
        }

        function showCookieBanner() {
            if (localStorage.getItem('cookieConsent')) return;
            document.getElementById('cookieBanner').style.display = 'block';
        }

        function acceptCookies() {
            localStorage.setItem('cookieConsent', 'accepted');
            document.getElementById('cookieBanner').style.display = 'none';
        }

        function dismissCookieBanner() {
            localStorage.setItem('cookieConsent', 'dismissed');
            document.getElementById('cookieBanner').style.display = 'none';
        }

        function exitSite() {
            window.location.href = "https://www.google.com";
        }

        // Skip the gate if already verified this session
        window.addEventListener('DOMContentLoaded', function () {
            if (sessionStorage.getItem('ageVerified') === 'true') {
                document.getElementById('ageGate').style.display = "none";
            }
        });

        function toggleLang() {
            document.getElementById('langToggle').classList.toggle('active');
            // hook translation logic here later
        }

        function submitFooterNewsletter(e) {
            e.preventDefault();
            var first = document.getElementById('footerFirstName');
            var last = document.getElementById('footerLastName');
            var email = document.getElementById('footerEmail');
            var emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            var valid = true;

            document.getElementById('footerFirstNameError').textContent = '';
            document.getElementById('footerLastNameError').textContent = '';
            document.getElementById('footerEmailError').textContent = '';
            first.classList.remove('invalid');
            last.classList.remove('invalid');
            email.classList.remove('invalid');

            if (!first.value.trim()) {
                document.getElementById('footerFirstNameError').textContent = 'Required.';
                first.classList.add('invalid');
                valid = false;
            }
            if (!last.value.trim()) {
                document.getElementById('footerLastNameError').textContent = 'Required.';
                last.classList.add('invalid');
                valid = false;
            }
            if (!emailPattern.test(email.value.trim())) {
                document.getElementById('footerEmailError').textContent = 'Enter a valid email.';
                email.classList.add('invalid');
                valid = false;
            }
            if (!valid) return false;

            first.value = ''; last.value = ''; email.value = '';
            return false;
        }

    </script>
</body>
</html>
