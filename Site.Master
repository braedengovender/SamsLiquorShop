    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>
    <script>
        function toggleTheme() {
            var current = document.documentElement.getAttribute('data-theme');
            var next = current === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            document.getElementById('themeIcon').innerHTML = next === 'dark' ? '&#9728;' : '&#9789;';
            localStorage.setItem('theme', next);
        }

        function toggleSearch() {
            var bar = document.getElementById('searchBar');
            var isHidden = bar.style.display === 'none';
            bar.style.display = isHidden ? 'block' : 'none';
            if (isHidden) {
                document.getElementById('headerSearchInput').focus();
            } else {
                document.getElementById('searchSuggestions').style.display = 'none';
            }
        }

        function clearHeaderSearch() {
            var input = document.getElementById('headerSearchInput');
            input.value = '';
            input.focus();
            document.getElementById('searchClearBtn').style.display = 'none';
            document.getElementById('searchSuggestions').style.display = 'none';
        }

        (function () {
            var input = document.getElementById('headerSearchInput');
            var box = document.getElementById('searchSuggestions');
            var clearBtn = document.getElementById('searchClearBtn');
            var debounceTimer = null;
            var activeIndex = -1;

            function escapeHtml(str) {
                var div = document.createElement('div');
                div.textContent = str;
                return div.innerHTML;
            }

            function goToSearch(term) {
                showPageLoader();
                window.location.href = 'Shop.aspx?search=' + encodeURIComponent(term);
            }

            function render(items) {
                if (!items || items.length === 0) {
                    box.innerHTML = '<div class="search-suggestion-empty">No matching products</div>';
                    box.style.display = 'block';
                    activeIndex = -1;
                    return;
                }

                box.innerHTML = items.map(function (item) {
                    return '<a href="Shop.aspx?search=' + encodeURIComponent(item.name) + '" class="search-suggestion-item">' + escapeHtml(item.name) + '</a>';
                }).join('');
                box.style.display = 'block';
                activeIndex = -1;

                box.querySelectorAll('.search-suggestion-item').forEach(function (link) {
                    link.addEventListener('click', function () { showPageLoader(); });
                });
            }

            input.addEventListener('input', function () {
                var term = input.value.trim();
                clearBtn.style.display = term.length > 0 ? 'flex' : 'none';
                clearTimeout(debounceTimer);

                if (term.length < 2) {
                    box.style.display = 'none';
                    return;
                }

                debounceTimer = setTimeout(function () {
                    fetch('SearchSuggestions.ashx?term=' + encodeURIComponent(term))
                        .then(function (res) { return res.json(); })
                        .then(render)
                        .catch(function () { box.style.display = 'none'; });
                }, 250);
            });

            input.addEventListener('keydown', function (e) {
                var items = box.querySelectorAll('.search-suggestion-item');

                if (e.key === 'ArrowDown' && items.length > 0) {
                    e.preventDefault();
                    activeIndex = Math.min(activeIndex + 1, items.length - 1);
                    items.forEach(function (it, i) { it.classList.toggle('is-active', i === activeIndex); });
                } else if (e.key === 'ArrowUp' && items.length > 0) {
                    e.preventDefault();
                    activeIndex = Math.max(activeIndex - 1, 0);
                    items.forEach(function (it, i) { it.classList.toggle('is-active', i === activeIndex); });
                } else if (e.key === 'Enter') {
                    e.preventDefault();
                    if (activeIndex >= 0 && items[activeIndex]) {
                        goToSearch(items[activeIndex].textContent);
                    } else if (input.value.trim().length > 0) {
                        goToSearch(input.value.trim());
                    }
                } else if (e.key === 'Escape') {
                    box.style.display = 'none';
                }
            });

            document.addEventListener('click', function (e) {
                if (!e.target.closest('.search-bar')) {
                    box.style.display = 'none';
                }
            });
        })();

        // Set the correct icon on load based on saved preference
        window.addEventListener('DOMContentLoaded', function () {
            var current = document.documentElement.getAttribute('data-theme');
            document.getElementById('themeIcon').innerHTML = current === 'dark' ? '&#9728;' : '&#9789;';
        });

        (function populateDobDropdowns() {
            var daySel = document.getElementById('dobDay');
            var monthSel = document.getElementById('dobMonth');
            var yearSel = document.getElementById('dobYear');

            for (var d = 1; d <= 31; d++) {
                daySel.innerHTML += '<option value="' + d + '">' + d + '</option>';
            }

            var months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
            for (var m = 0; m < months.length; m++) {
                monthSel.innerHTML += '<option value="' + (m + 1) + '">' + months[m] + '</option>';
            }

            var currentYear = new Date().getFullYear();
            for (var y = currentYear; y >= currentYear - 100; y--) {
                yearSel.innerHTML += '<option value="' + y + '">' + y + '</option>';
            }
        })();

        function verifyAge() {
            var day = document.getElementById('dobDay').value;
            var month = document.getElementById('dobMonth').value;
            var year = document.getElementById('dobYear').value;
            var errorEl = document.getElementById('ageError');

            if (!day || !month || !year) {
                errorEl.textContent = "Please select your full date of birth.";
                errorEl.style.display = "block";
                return;
            }

            var dob = new Date(year, month - 1, day);
            var today = new Date();
            var age = today.getFullYear() - dob.getFullYear();
            var m = today.getMonth() - dob.getMonth();
            if (m < 0 || (m === 0 && today.getDate() < dob.getDate())) {
                age--;
            }

            if (age < 18) {
                errorEl.textContent = "You must be 18 or older to enter this site.";
                errorEl.style.display = "block";
                return;
            }

            errorEl.style.display = "none";
            document.getElementById('ageGate').style.display = "none";
            sessionStorage.setItem('ageVerified', 'true');
            showNewsletter();
        }

        function showNewsletter() {
            document.getElementById('newsletterModal').classList.add('is-open');
        }

        function closeNewsletter() {
            document.getElementById('newsletterModal').classList.remove('is-open');
            document.getElementById('newsletterForm').style.display = 'block';
            document.getElementById('newsletterSuccess').style.display = 'none';
            document.getElementById('nlFirstName').value = '';
            document.getElementById('nlLastName').value = '';
            document.getElementById('nlEmail').value = '';
            showCookieBanner();
        }

        function submitNewsletter(e) {
            e.preventDefault();
            var first = document.getElementById('nlFirstName');
            var last = document.getElementById('nlLastName');
            var email = document.getElementById('nlEmail');
            var valid = true;

            document.getElementById('nlFirstNameError').textContent = '';
            document.getElementById('nlLastNameError').textContent = '';
            document.getElementById('nlEmailError').textContent = '';
            first.classList.remove('invalid');
            last.classList.remove('invalid');
            email.classList.remove('invalid');

            if (!first.value.trim()) {
                document.getElementById('nlFirstNameError').textContent = 'Please enter your first name.';
                first.classList.add('invalid');
                valid = false;
            }
            if (!last.value.trim()) {
                document.getElementById('nlLastNameError').textContent = 'Please enter your last name.';
                last.classList.add('invalid');
                valid = false;
            }
            var emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailPattern.test(email.value.trim())) {
                document.getElementById('nlEmailError').textContent = 'Please enter a valid email address.';
                email.classList.add('invalid');
                valid = false;
            }

            if (!valid) return false;

            // TODO: wire this to your sign-up endpoint / code-behind method
            document.getElementById('newsletterForm').style.display = 'none';
            document.getElementById('newsletterSuccess').style.display = 'block';
            return false;
        }

        function toggleChatbot() {
            var panel = document.getElementById('chatbotPanel');
            panel.style.display = panel.style.display === 'none' ? 'flex' : 'none';
        }

        var chatAnswers = {
            hours: "We're open Mon–Thu 09:00–18:00, Fri–Sat 09:00–20:00, and Sun 10:00–15:00 (same on public holidays).",
            location: "You'll find us at 21 Coronation Road, Tongaat, Durban. There's a map in our footer!",
            delivery: "Yes! We offer same-day delivery in the Durban area on orders placed before 2pm.",
            loyalty: "Every purchase earns you points automatically once you're signed in — head to the Rewards page to see your balance and redeem discounts."
        };

        function askQuick(key) {
            var messages = document.getElementById('chatbotMessages');
            var questionText = document.querySelector('[onclick="askQuick(\'' + key + '\')"]').textContent;

            var userMsg = document.createElement('div');
            userMsg.className = 'chatbot-msg user';
            userMsg.textContent = questionText;
            messages.appendChild(userMsg);

            setTimeout(function () {
                var botMsg = document.createElement('div');
                botMsg.className = 'chatbot-msg bot';
                botMsg.textContent = chatAnswers[key];
                messages.appendChild(botMsg);
                messages.scrollTop = messages.scrollHeight;
            }, 400);

            messages.scrollTop = messages.scrollHeight;
        }

        function sendChatMessage(e) {
            e.preventDefault();
            var input = document.getElementById('chatbotInput');
            var messages = document.getElementById('chatbotMessages');
            if (!input.value.trim()) return false;

            var userMsg = document.createElement('div');
            userMsg.className = 'chatbot-msg user';
            userMsg.textContent = input.value;
            messages.appendChild(userMsg);

            input.value = '';

            setTimeout(function () {
                var text = userMsg.textContent.toLowerCase();
                var reply = "Thanks for your message! One of our team will get back to you shortly.";
                if (text.indexOf('hour') !== -1 || text.indexOf('open') !== -1) reply = chatAnswers.hours;
                else if (text.indexOf('where') !== -1 || text.indexOf('locat') !== -1 || text.indexOf('address') !== -1) reply = chatAnswers.location;
                else if (text.indexOf('deliver') !== -1) reply = chatAnswers.delivery;
                else if (text.indexOf('loyal') !== -1 || text.indexOf('reward') !== -1) reply = chatAnswers.loyalty;

                var botMsg = document.createElement('div');
                botMsg.className = 'chatbot-msg bot';
                botMsg.textContent = reply;
                messages.appendChild(botMsg);
                messages.scrollTop = messages.scrollHeight;
            }, 500);

            messages.scrollTop = messages.scrollHeight;
            return false;
        }

        function showCookieBanner() {
            if (localStorage.getItem('cookieConsent')) return;
            document.getElementById('cookieBanner').style.display = 'block';
        }

        function acceptCookies() {
            localStorage.setItem('cookieConsent', 'accepted');
            document.getElementById('cookieBanner').style.display = 'none';
        }

        function dismissCookieBanner() {
            localStorage.setItem('cookieConsent', 'dismissed');
            document.getElementById('cookieBanner').style.display = 'none';
        }

        function exitSite() {
            window.location.href = "https://www.google.com";
        }

        // Skip the gate if already verified this session
        window.addEventListener('DOMContentLoaded', function () {
            if (sessionStorage.getItem('ageVerified') === 'true') {
                document.getElementById('ageGate').style.display = "none";
            }
        });

        function toggleLang() {
            document.getElementById('langToggle').classList.toggle('active');
            // hook translation logic here later
        }

        function submitFooterNewsletter(e) {
            e.preventDefault();
            var first = document.getElementById('footerFirstName');
            var last = document.getElementById('footerLastName');
            var email = document.getElementById('footerEmail');
            var emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            var valid = true;

            document.getElementById('footerFirstNameError').textContent = '';
            document.getElementById('footerLastNameError').textContent = '';
            document.getElementById('footerEmailError').textContent = '';
            first.classList.remove('invalid');
            last.classList.remove('invalid');
            email.classList.remove('invalid');

            if (!first.value.trim()) {
                document.getElementById('footerFirstNameError').textContent = 'Required.';
                first.classList.add('invalid');
                valid = false;
            }
            if (!last.value.trim()) {
                document.getElementById('footerLastNameError').textContent = 'Required.';
                last.classList.add('invalid');
                valid = false;
            }
            if (!emailPattern.test(email.value.trim())) {
                document.getElementById('footerEmailError').textContent = 'Enter a valid email.';
                email.classList.add('invalid');
                valid = false;
            }
            if (!valid) return false;

            first.value = ''; last.value = ''; email.value = '';
            document.getElementById('footerNewsletterSuccess').style.display = 'block';
            setTimeout(function () {
                document.getElementById('footerNewsletterSuccess').style.display = 'none';
            }, 5000);
            return false;
        }

        function togglePasswordVisibility() {
            var pwd = document.getElementById('txtPassword');
            var icon = document.getElementById('eyeIcon');
            if (pwd.type === 'password') {
                pwd.type = 'text';
                icon.innerHTML = '&#128584;';
            } else {
                pwd.type = 'password';
                icon.innerHTML = '&#128065;';
            }
        }

        function validateLoginForm() {
            var username = document.getElementById('txtUsername');
            var password = document.getElementById('txtPassword');
            var usernameError = document.getElementById('usernameError');
            var passwordError = document.getElementById('passwordError');
            var valid = true;

            usernameError.textContent = '';
            passwordError.textContent = '';
            username.classList.remove('invalid');
            password.classList.remove('invalid');

            if (!username.value.trim()) {
                usernameError.textContent = 'Email or username is required.';
                username.classList.add('invalid');
                valid = false;
            }
            if (!password.value.trim()) {
                passwordError.textContent = 'Password is required.';
                password.classList.add('invalid');
                valid = false;
            }

            return valid;
        }

        function showPageLoader() {
            document.getElementById('pageLoader').style.display = 'flex';
        }

        function hidePageLoader() {
            document.getElementById('pageLoader').style.display = 'none';
        }

        // Show the loader the moment someone clicks a real navigation link
        // in the main nav or its dropdowns (category links, About Us submenu, etc.)
        document.querySelectorAll('.nav-links a, .dropdown-menu a').forEach(function (link) {
            link.addEventListener('click', function (e) {
                var href = this.getAttribute('href');
                if (href && href.indexOf('#') !== 0 && href.indexOf('javascript:') !== 0) {
                    showPageLoader();
                }
            });
        });

        // Safety net: if the user navigates back via the browser's
        // back/forward cache, the old page (with loader still visible)
        // can be restored instantly — make sure it's hidden again.
        window.addEventListener('pageshow', function () {
            hidePageLoader();
        });
    </script>
</body>
</html>
